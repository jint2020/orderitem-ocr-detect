# 复制为 .env 后按需修改；不创建 .env 时使用下列默认值。

# 宿主机端口，映射到容器内的 5000
OCR_PORT=8080

# gunicorn worker 数；每个 worker 独立懒加载模型，内存随之线性增长。
# CPU 推理建议不超过 CPU 核数 / 2。
GUNICORN_WORKERS=2

# 模型目录（容器内相对 /app，对应只读挂载的 ./models）。
# 默认值与 app/config.py 一致，通常不需要改；
# 若检测模型目录保留了 modelscope 的原名 PP-OCRv6_small_det，则取消下一行注释。
# DETECTION_MODEL_DIR=models/PP-OCRv6_small_det
# RECOGNITION_MODEL_DIR=models/PP-OCRv6_medium_rec
# DOC_ORIENTATION_MODEL_DIR=models/PP-LCNet_x1_0_doc_ori

# 上传大小上限（字节），默认 20 MiB
# MAX_CONTENT_LENGTH=20971520

# ---- 构建加速（仅影响 docker compose build，国内服务器强烈建议开启）----
# 腾讯云服务器（内网源，免流量、最快）：
# APT_MIRROR_HOST=mirrors.tencentyun.com
# PIP_INDEX_URL=https://mirrors.tencentyun.com/pypi/simple
#
# 阿里云服务器：
# APT_MIRROR_HOST=mirrors.cloud.aliyuncs.com
# PIP_INDEX_URL=https://mirrors.cloud.aliyuncs.com/pypi/simple
#
# 通用公网镜像（非上述云厂商机器）：
# APT_MIRROR_HOST=mirrors.tuna.tsinghua.edu.cn
# PIP_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
