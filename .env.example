# 复制为 .env 后按需修改；不创建 .env 时使用下列默认值。

# 宿主机端口，映射到容器内的 5000
OCR_PORT=8080

# 端口绑定地址。默认 0.0.0.0（所有网卡）。
# 前面挂了 Nginx 等反向代理时设为 127.0.0.1，避免公网绕过代理直连。
# OCR_BIND_HOST=127.0.0.1

# gunicorn worker 数；每个 worker 独立懒加载模型，内存随之线性增长。
GUNICORN_WORKERS=2

# 每个 worker 的请求线程数。OCR 是 CPU 密集型，默认 1（排队优于超额订阅）。
# GUNICORN_THREADS=1

# 线程预算：三者相乘才是真实的线程压力，应约等于 CPU 核数
#     GUNICORN_WORKERS × GUNICORN_THREADS × CPU_THREADS ≈ 核数
# 4 核机器的两种典型取法：
#   单张最快（延迟优先）  WORKERS=1 THREADS=1 CPU_THREADS=4
#   吞吐最大（并发优先）  WORKERS=4 THREADS=1 CPU_THREADS=1
#   折中                 WORKERS=2 THREADS=1 CPU_THREADS=2

# 模型目录（容器内相对 /app，对应只读挂载的 ./models）。
# 默认值与 app/config.py 一致，通常不需要改；
# 若检测模型目录保留了 modelscope 的原名 PP-OCRv6_small_det，则取消下一行注释。
# DETECTION_MODEL_DIR=models/PP-OCRv6_small_det
# RECOGNITION_MODEL_DIR=models/PP-OCRv6_medium_rec
# DOC_ORIENTATION_MODEL_DIR=models/PP-LCNet_x1_0_doc_ori

# 上传大小上限（字节），默认 20 MiB
# MAX_CONTENT_LENGTH=20971520

# ---- 鉴权 ----
# API Key，逗号分隔可配多个（便于轮换：先加新 key，调用方切换完毕后再删旧 key）。
# 调用方通过请求头传递：  X-API-Key: <key>
# 留空 = 不鉴权。接口会返回真实号码与姓名，公网暴露时必须设置。
# 生成： openssl rand -hex 32
# API_KEYS=

# oneDNN(MKLDNN) 加速。PaddleOCR 自身默认开启，但 paddlepaddle 3.3.1 的
# oneDNN + PIR 执行器加载 PP-OCRv6 检测模型时会抛 NotImplementedError，
# 因此本项目默认关闭。确认所在环境不受影响时可设为 true。
# ENABLE_MKLDNN=false
#
# PIR 开关。注意：ENABLE_MKLDNN=true + ENABLE_NEW_IR=false 已实测无效，仍会崩溃，
# 因为 paddlex 关掉 PIR 后仍无条件启用新执行器，而崩溃就在新执行器里。
# 保留该项仅为便于在其他 paddle 版本上复测。
# ENABLE_NEW_IR=true

# ---- 推理后端 ----
# paddle（默认）：paddlepaddle 自带后端。因 oneDNN 不可用，实际走未加速的通用 CPU 算子。
# onnxruntime：绕开 paddle 后端。需先把三个模型转成 ONNX（见 models/README.md），
#              每个模型目录里要有 inference.onnx。
# INFERENCE_ENGINE=onnxruntime

# ---- 性能调优 ----
# 单次推理的 CPU 线程数。PaddleOCR 默认 10，与多 worker 叠加会严重超额订阅。
# 默认取 核数/2，配合默认的 2 个 worker 正好用满。规则：
#   GUNICORN_WORKERS × CPU_THREADS ≈ 核数
# CPU_THREADS=2
#
# 检测模型输入缩放。PaddleOCR pipeline 默认 limit_side_len=64 / limit_type=min，
# 即大图几乎不缩小，高分辨率照片检测极慢。设成下面两行可把长边缩到 960，
# 通常是提速最大的一项，代价是小字可能漏检——改后请用真实样本回归字段准确率。
# TEXT_DET_LIMIT_SIDE_LEN=960
# TEXT_DET_LIMIT_TYPE=max

# ---- 构建加速（仅影响 docker compose build，国内服务器强烈建议开启）----
# 三个变量分工不同，建议一起设置：
#   APT_MIRROR_HOST  apt 换源，影响系统库安装那一层
#   PIP_INDEX_URL    pip/uv 索引，影响 `pip install uv` 和 `uv pip install gunicorn`
#   PYPI_FILES_BASE  改写 uv.lock 里的 wheel 下载地址。这一层要下约 400 MB，
#                    是构建耗时的大头；不设置它，前两个变量对该层没有任何作用。
#
# 腾讯云服务器（内网源，免流量、最快）：
# APT_MIRROR_HOST=mirrors.tencentyun.com
# PIP_INDEX_URL=https://mirrors.tencentyun.com/pypi/simple
# PYPI_FILES_BASE=https://mirrors.tencentyun.com/pypi
#
# 阿里云服务器：
# APT_MIRROR_HOST=mirrors.cloud.aliyuncs.com
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
# PYPI_FILES_BASE=https://mirrors.aliyun.com/pypi
#
# 通用公网镜像（非上述云厂商机器）：
# APT_MIRROR_HOST=mirrors.tuna.tsinghua.edu.cn
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PYPI_FILES_BASE=https://pypi.tuna.tsinghua.edu.cn
